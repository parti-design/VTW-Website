---
// Everything in <head>. The stylesheets are the site's own files under /assets/css,
// linked in the order they cascade (brand.css last: it owns the lockup and the
// contrast corrections), not bundled, so the CSS ports from Jekyll unchanged.
import { commit } from '../lib/build-info'
import { seo, type SeoInput } from '../lib/seo'
import { site } from '../site.config'

interface Props extends SeoInput {
  stylesheets: string[]
}
const { stylesheets, ...input } = Astro.props
const s = seo(input)
---
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<link rel="icon" href="/favicon.ico" sizes="any" />
<link rel="apple-touch-icon" href="/assets/images/vtw-icon-180.png" />

<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Alegreya+Sans:ital,wght@0,300;0,400;0,500;0,700;1,400&family=Alegreya:ital,wght@0,400;0,500;1,400&display=swap" rel="stylesheet" />

{stylesheets.map((href) => <link rel="stylesheet" href={href} />)}
<link rel="alternate" type="application/rss+xml" title={site.title} href="/feed.xml" />

<title>{s.title}</title>
<meta name="generator" content={Astro.generator} />
<meta property="og:title" content={s.pageTitle} />
<meta name="author" content={s.author} />
<meta property="og:locale" content={site.locale} />
<meta name="description" content={s.description} />
<meta property="og:description" content={s.description} />
<link rel="canonical" href={s.canonical} />
<meta property="og:url" content={s.canonical} />
<meta property="og:site_name" content={site.title} />
<meta property="og:type" content={s.ogType} />
{s.publishedTime && <meta property="article:published_time" content={s.publishedTime} />}
<meta name="twitter:card" content="summary" />
<meta property="twitter:title" content={s.pageTitle} />
<script type="application/ld+json" set:html={s.jsonLd} />
<meta name="edit:commit" content={commit} />

<!-- Umami — self-hosted, cookieless. data-domains pins reporting to the live
     host so local builds and previews send nothing. -->
<script is:inline defer src={site.umami.src} data-website-id={site.umami.websiteId} data-domains={site.umami.domains}></script>
