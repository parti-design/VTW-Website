---
// The footer on every page. Its Articles link is the only internal path to /articles/
// (articles are deliberately kept out of the main menu), so it stays.
const year = new Date().getUTCFullYear()
---
<footer class="hft">
  <div class="vtw-rule hft__rule" role="presentation"></div>

  <div class="hft__inner">

    <div class="hft__brand">
      <span class="vtw" aria-hidden="true">
        <img src="/assets/images/vtw-wave.svg" alt="" />
        <span class="vtw__t"><span>VTW</span></span>
        <img src="/assets/images/vtw-wave.svg" alt="" />
      </span>
      <p class="hft__entity">Enterprises&nbsp;LLC</p>
    </div>

    <div class="hft__cols">
      <div class="hft__col">
        <h2 class="hft__ct">Office</h2>
        <p class="hft__cv">P.O. Box 310<br />West Hurley, NY 12491</p>
      </div>

      <div class="hft__col">
        <h2 class="hft__ct">Working across</h2>
        <p class="hft__cv">Columbia, Dutchess, Greene<br />and Ulster counties, New York</p>
      </div>

      <nav class="hft__col" aria-label="Secondary">
        <h2 class="hft__ct">More</h2>
        <ul class="hft__list">
          <li><a class="hft__link" href="/articles/">Articles</a></li>
          <li><a class="hft__link" href="/faq/">FAQ</a></li>
          <li><a class="hft__link" href="/contact/">Contact</a></li>
        </ul>
      </nav>
    </div>

  </div>

  <div class="hft__base">
    <p class="hft__copy">&copy; {year} Von Trapp Winter Enterprises LLC. Hudson Valley, NY.</p>
  </div>
</footer>
