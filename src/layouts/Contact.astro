---
// The contact page. Phone and email are printed reversed, in pieces, and put back
// together by the script below, so a scraper reading the HTML finds neither. There is
// no form. Was _layouts/contact.html. Every text is in _pages/contact.md.
//
// Two of them have no label: the "Available with JavaScript enabled" placeholder, which
// the script replaces before anyone can click it, and the <noscript> notes, which a
// browser running scripts (the editor's included) never puts on the page. They are
// edited in the file.
import type { PageWith } from '../lib/content'
import { edit, type EditOptions } from '../lib/edit'
import { markdownInline } from '../lib/jekyll'
import Default from './Default.astro'

interface Props {
  page: PageWith<'contact'>
  html: string
}
const { page, html } = Astro.props
const d = page.data
const file = page.filePath
const label = (key: string, name: string, more: EditOptions = {}) => edit(file, `/${key}`, { label: name, ...more })

const digits = (d.phone ?? '').replace(/[^\d]/g, '')
const phone = { area: digits.slice(0, 3), prefix: digits.slice(3, 6), line: digits.slice(6, 10) }
const [user = '', domain = ''] = (d.email ?? '').split('@')
const email = { user, domain }
const rev = (s: string) => [...s].reverse().join('')
---
<Default path={d.permalink} title={d.title} description={d.description} bodyClass={d.body_class} file={file}>
<!-- ═══ OPENING ═══ -->
<section class="cmast">
  <div class="cmast__inner">
    <p class="cmast__kicker" {...label('kicker', 'Small line above the heading')}>{d.kicker}</p>
    <h1 class="cmast__lead" {...label('lead', 'Heading', { type: 'rich', marks: 'bold italic' })} set:html={markdownInline(d.lead)} />
    <div class="cmast__intro" {...edit(file, 'body', { type: 'rich', label: 'Introduction' })}>
      <Fragment set:html={html} />
    </div>
  </div>
</section>

<!-- ═══ GUIDANCE + DETAILS ═══ -->
<section class="cbody" data-animate>
  <div class="cbody__inner">
    <div class="cbody__guide">
      <p class="cbody__label" {...label('include_label', 'List heading')}>{d.include_label}</p>
      <ul class="cbody__list">{d.include.map((item, i) => (<Fragment>{'\n        '}<li {...label(`include/${i}`, `List item ${i + 1}`)}>{item}</li></Fragment>))}
      </ul>
    </div>

    <div class="cbody__details">{phone.area && phone.prefix && phone.line && (
      <div class="cdetail">
        <span class="cdetail__label" {...label('phone_label', 'Phone: label')}>{d.phone_label}</span>
        <a
          class="cdetail__value"
          href="#"
          data-phone-link
          data-area-rev={rev(phone.area)}
          data-prefix-rev={rev(phone.prefix)}
          data-line-rev={rev(phone.line)}
          {...label('phone', 'Phone number')}
        >{d.script_needed}</a>
        <noscript><span class="cdetail__value">{d.phone_noscript}</span></noscript>
      </div>
      )}{email.user && email.domain && (
      <div class="cdetail">
        <span class="cdetail__label" {...label('email_label', 'Email: label')}>{d.email_label}</span>
        <a
          class="cdetail__value"
          href="#"
          data-email-link
          data-user-rev={rev(email.user)}
          data-domain-rev={rev(email.domain)}
          {...label('email', 'Email address')}
        >{d.script_needed}</a>
        <noscript><span class="cdetail__value">{d.email_noscript}</span></noscript>
      </div>
      )}

      <div class="cdetail">
        <span class="cdetail__label" {...label('based_label', 'Location: label')}>{d.based_label}</span>
        <span class="cdetail__value" {...label('based', 'Location')}>{d.based}</span>
      </div>
    </div>
  </div>
</section>

<script is:inline>
  document.querySelectorAll('[data-phone-link]').forEach((link) => {
    const area = (link.dataset.areaRev || '').split('').reverse().join('');
    const prefix = (link.dataset.prefixRev || '').split('').reverse().join('');
    const line = (link.dataset.lineRev || '').split('').reverse().join('');
    if (!area || !prefix || !line) return;
    link.href = `tel:${area}${prefix}${line}`;
    link.textContent = `${area} ${prefix} ${line}`;
  });

  document.querySelectorAll('[data-email-link]').forEach((link) => {
    const user = (link.dataset.userRev || '').split('').reverse().join('');
    const domain = (link.dataset.domainRev || '').split('').reverse().join('');
    if (!user || !domain) return;
    link.href = `mailto:${user}@${domain}`;
    link.textContent = `${user}@${domain}`;
  });
</script>
</Default>
