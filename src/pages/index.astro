---
// The home page. Every text on it is a key in index.md's front matter, labelled for the
// editor; the project cards and testimonials are labelled with their own files. Was
// _layouts/home.html, which stood alone rather than extending the default layout, and
// still does: fewer stylesheets, no <main class="im">.
//
// The step numbers (01-04) count the services; they are not text to edit.
import { getCollection } from 'astro:content'
import EditBridge from '../components/EditBridge.astro'
import Head from '../components/Head.astro'
import Img from '../components/Img.astro'
import SiteFooter from '../components/SiteFooter.astro'
import SiteHeader from '../components/SiteHeader.astro'
import { getHome, getProjects, projectCover, projectLabels, projectUrl, SITE_FILE } from '../lib/content'
import { edit, type EditOptions } from '../lib/edit'
import { backgroundVars, LARGE } from '../lib/images'

const home = await getHome()
const p = home.data
const file = home.filePath
const label = (key: string, name: string, more: EditOptions = {}) => edit(file, `/${key}`, { label: name, ...more })
/** A line break typed in the editor becomes a <br />, as Liquid's newline_to_br did. */
const lines = (s: string) => s.split('\n')

// The first three featured projects, in file-name order. Marking a fourth as featured
// does not push one off by surprise elsewhere: the projects page still tags them all.
const featured = (await getProjects()).filter((pr) => pr.data.featured).slice(0, 3)
const testimonials = (await getCollection('testimonials'))
  .filter((x) => x.data.featured)
  .sort((a, b) => Number(a.id) - Number(b.id))
const TESTIMONIALS_FILE = '_data/testimonials.yml'

const stylesheets = ['/assets/css/brand-tokens.css', '/assets/css/main.css', '/assets/css/home.css', '/assets/css/brand.css']
---
<!DOCTYPE html>
<html lang="en">
<head>
  <Head
    stylesheets={stylesheets}
    path="/"
    title={p.title}
    description={p.description}
    file={file}
    titleLabel={edit(SITE_FILE, '/tagline', { label: 'Home page browser tab: the words after the site name' })}
  />
</head>
<body class="page-home">

  <!-- ═══ NAV ═══════════════════════════════════════════════════════════════ -->
  <SiteHeader current="/" />

  <main>

    <!-- ═══ HERO ══════════════════════════════════════════════════════════════ -->
    <section class="hh">
      <div class:list={['hh__photo', { 'has-image': p.hero_image }]} style={p.hero_image ? backgroundVars(p.hero_image) : undefined} aria-hidden="true" {...label('hero_image', 'Top: photo', { type: 'image', optional: true })}></div>
      <div class="hh__inner">
        <p class="hh__label" {...label('hero_label', 'Top: small line above the headline')}>{p.hero_label}</p>
        <h1 class="hh__heading" {...label('hero_heading', 'Top: headline', { multiline: true })}>{lines(p.hero_heading).map((l, i) => (<Fragment>{i > 0 && <br />}{l}</Fragment>))}</h1>
        <p class="hh__sub" {...label('hero_subheading', 'Top: text under the headline', { multiline: true })}>{lines(p.hero_subheading).map((l, i) => (<Fragment>{i > 0 && <br />}{l}</Fragment>))}</p>
        <a class="hh__cta" href="/contact/" {...label('hero_cta_text', 'Top: button')}>{p.hero_cta_text}</a>
      </div>
      <div class="hh__scroll-hint" aria-hidden="true">
        <span {...label('scroll_hint', 'Top: scroll hint')}>{p.scroll_hint}</span>
        <div class="hh__scroll-line"></div>
      </div>
    </section>

    <!-- ═══ STATEMENT ═════════════════════════════════════════════════════════ -->
    <section class="hs" data-animate>
      <div class="hs__inner">
        <p class="hs__text" {...label('statement_text', 'Statement')}>{p.statement_text}</p>
        <p class="hs__aside" {...label('statement_aside', 'Statement: the line after it')}>{p.statement_aside}</p>
      </div>
      <div class:list={['hs__photo', { 'has-image': p.statement_image }]} style={p.statement_image ? backgroundVars(p.statement_image) : undefined} aria-hidden="true" {...label('statement_image', 'Statement: photo', { type: 'image', optional: true })}></div>
    </section>

    <!-- ═══ ADVOCATE ══════════════════════════════════════════════════════════ -->
    <section class="hav" data-animate>
      <div class:list={['hav__photo', { 'has-image': p.advocate_image }]} style={p.advocate_image ? backgroundVars(p.advocate_image) : undefined} aria-hidden="true" {...label('advocate_image', 'Quote: photo', { type: 'image', optional: true })}></div>
      <div class="hav__inner">
        <div class="hav__label-col">
          <span class="hav__label" {...label('advocate_label', 'Quote: small heading')}>{p.advocate_label}</span>
        </div>
        <div class="hav__body">
          <blockquote class="hav__quote" {...label('advocate_quote', 'Quote (the quotation marks are added)', { multiline: true })}>&ldquo;{p.advocate_quote}&rdquo;</blockquote>
          <cite class="hav__cite" {...label('advocate_name', 'Quote: who says it')}>{p.advocate_name}</cite>
          <p class="hav__context" {...label('advocate_context', 'Quote: line under the name')}>{p.advocate_context}</p>
        </div>
      </div>
    </section>

    <!-- ═══ SERVICES ══════════════════════════════════════════════════════════ -->
    <section class="hsv" data-animate>
      <div class="hsv__inner">
        <p class="hsv__header-label" {...label('services_label', 'Services: heading')}>{p.services_label}</p>
{p.services.map((s, i) => (<Fragment>
        <div class="hsv__item" data-animate data-delay={i * 100}>
          <span class="hsv__num">{String(i + 1).padStart(2, '0')}</span>
          <div class="hsv__content">
            <h3 class="hsv__title" {...label(`services/${i}/title`, `Service ${i + 1}: name`)}>{s.title}</h3>
            <p class="hsv__desc" {...label(`services/${i}/text`, `Service ${i + 1}: text`)}>{s.text}</p>
          </div>
          <a class="hsv__link" href="/services/" {...label('services_link', 'Services: link text')}>{p.services_link}</a>
        </div>
</Fragment>))}
      </div>
    </section>

    <!-- ═══ PROJECTS ══════════════════════════════════════════════════════════ -->{featured.length > 0 && (
    <section class="hpj" data-animate>
      <div class="hpj__inner">
        <div class="hpj__header">
          <p class="hpj__label" {...label('projects_label', 'Projects: heading')}>{p.projects_label}</p>
          <a class="hpj__all" href="/projects/" {...label('projects_link', 'Projects: link to all projects')}>{p.projects_link}</a>
        </div>
        <div class="hpj__grid">{featured.map((project) => {
          const cover = projectCover(project)
          const pf = project.filePath
          return (
          <a class="hpj__card" href={projectUrl(project)}>
            <div class="hpj__img-wrap">{cover ? (
              <Img src={cover} alt={project.data.title} sizes="(max-width: 760px) calc(100vw - 3rem), 384px" widths={LARGE} attrs={edit(pf, '/cover_image', projectLabels.cover)} />
            ) : (
              <div class="hpj__img-placeholder"></div>
            )}</div>
            <div class="hpj__card-body">
              <span class="hpj__type" {...edit(pf, '/type', projectLabels.type)}>{project.data.type}</span>
              <h3 class="hpj__title" {...edit(pf, '/title', projectLabels.title)}>{project.data.title}</h3>{project.data.location && <p class="hpj__location" {...edit(pf, '/location', projectLabels.location)}>{project.data.location}</p>}</div>
          </a>
          )
        })}</div>
      </div>
    </section>
    )}

    <!-- ═══ TESTIMONIAL ═══════════════════════════════════════════════════════ -->{testimonials.length > 0 && (
    <section class="htm" data-animate>
      <div class="htminner" data-testimonial-slider>
        <div class="htm__viewport">
          <div class="htm__track">{testimonials.map((x) => (
            <article class="htm__slide">
              <blockquote class="htm__quote" {...edit(TESTIMONIALS_FILE, `/testimonials/${x.id}/quote`, { label: 'Testimonial (the quotation marks are added)', multiline: true })}>&ldquo;{x.data.quote}&rdquo;</blockquote>
              <footer class="htm__footer">
                <span class="htm__name" {...edit(TESTIMONIALS_FILE, `/testimonials/${x.id}/name`, { label: 'Testimonial: who' })}>{x.data.name}</span>{x.data.project && (
                <span class="htm__project" {...edit(TESTIMONIALS_FILE, `/testimonials/${x.id}/project`, { label: 'Testimonial: which project' })}>{x.data.project}</span>
                )}</footer>
            </article>
          ))}</div>
        </div>{testimonials.length > 1 && (
        <div class="htm__controls">
          <button class="htm__btn" type="button" data-testimonial-prev aria-label="Previous testimonial">&larr;</button>
          <div class="htm__dots">{testimonials.map((_, i) => (
            <button class:list={['htm__dot', { 'is-active': i === 0 }]} type="button" data-testimonial-to={i} aria-label={`Go to testimonial ${i + 1}`}></button>
          ))}</div>
          <button class="htm__btn" type="button" data-testimonial-next aria-label="Next testimonial">&rarr;</button>
        </div>
        )}</div>
    </section>
    )}

    <!-- ═══ CTA ═══════════════════════════════════════════════════════════════ -->
    <section class="hct" data-animate>
      <div class="hct__inner">
        <h2 class="hct__heading" {...label('home_cta_heading', 'Bottom: heading', { multiline: true })}>{lines(p.home_cta_heading).map((l, i) => (<Fragment>{i > 0 && <br />}{l}</Fragment>))}</h2>
        <p class="hct__sub" {...label('home_cta_sub', 'Bottom: text')}>{p.home_cta_sub}</p>
        <a class="hct__link" href="/contact/" {...label('home_cta_link_text', 'Bottom: link')}>{p.home_cta_link_text}</a>
      </div>
    </section>

  </main>

  <!-- ═══ FOOTER ════════════════════════════════════════════════════════════ -->
  <SiteFooter />

  <!-- ═══ SCRIPTS ═══════════════════════════════════════════════════════════ -->
  <script is:inline>
    // Nav: become opaque on scroll
    const nav = document.getElementById('hn');
    window.addEventListener('scroll', () => {
      nav.classList.toggle('hn--scrolled', window.scrollY > 80);
    }, { passive: true });

    // Mobile menu toggle
    const navToggle = document.getElementById('hn-toggle');
    const navMenu = document.getElementById('hn-nav');
    if (navToggle && navMenu) {
      const setMenu = (open) => {
        navToggle.setAttribute('aria-expanded', String(open));
        navToggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
        navMenu.classList.toggle('is-open', open);
        document.body.classList.toggle('nav-open', open);
      };
      navToggle.addEventListener('click', () => {
        setMenu(navToggle.getAttribute('aria-expanded') !== 'true');
      });
      navMenu.querySelectorAll('a').forEach((link) => {
        link.addEventListener('click', () => setMenu(false));
      });
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') setMenu(false);
      });
      window.addEventListener('resize', () => {
        if (window.innerWidth > 760) setMenu(false);
      });
    }

    // Scroll-reveal animation
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          const delay = entry.target.dataset.delay || 0;
          setTimeout(() => entry.target.classList.add('is-visible'), Number(delay));
        }
      });
    }, { threshold: 0.12 });

    document.querySelectorAll('[data-animate]').forEach(el => observer.observe(el));

    // Testimonial slider
    document.querySelectorAll('[data-testimonial-slider]').forEach((slider) => {
      const track = slider.querySelector('.htm__track');
      const slides = Array.from(slider.querySelectorAll('.htm__slide'));
      const dots = Array.from(slider.querySelectorAll('[data-testimonial-to]'));
      const prev = slider.querySelector('[data-testimonial-prev]');
      const next = slider.querySelector('[data-testimonial-next]');
      let index = 0;
      let intervalId;

      if (!track || slides.length <= 1) return;

      const goTo = (newIndex) => {
        index = (newIndex + slides.length) % slides.length;
        track.style.transform = `translateX(-${index * 100}%)`;

        slides.forEach((slide, slideIndex) => {
          slide.classList.toggle('is-active', slideIndex === index);
        });
        dots.forEach((dot, dotIndex) => {
          dot.classList.toggle('is-active', dotIndex === index);
        });
      };

      const restartAuto = () => {
        window.clearInterval(intervalId);
        intervalId = window.setInterval(() => goTo(index + 1), 6000);
      };

      prev?.addEventListener('click', () => { goTo(index - 1); restartAuto(); });
      next?.addEventListener('click', () => { goTo(index + 1); restartAuto(); });
      dots.forEach((dot) => {
        dot.addEventListener('click', () => {
          goTo(Number(dot.dataset.testimonialTo));
          restartAuto();
        });
      });

      window.addEventListener('resize', () => goTo(index));
      goTo(index);
      restartAuto();
    });
  </script>

  <EditBridge />

</body>
</html>
