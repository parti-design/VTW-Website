---
// One page per live article, at /:year/:month/:day/:title/ (Jekyll's permalink).
// Parked articles (published: false) get no page. Was _layouts/post.html.
import Default from '../../../../layouts/Default.astro'
import { getPosts, getSite, postSlug, postUrl, SITE_FILE, type Post } from '../../../../lib/content'
import { longDate, xmlschema } from '../../../../lib/dates'
import { edit } from '../../../../lib/edit'
import { renderBody } from '../../../../lib/jekyll'

export async function getStaticPaths() {
  return (await getPosts()).map((post) => {
    const [year, month, day] = xmlschema(post.data.date).slice(0, 10).split('-')
    return { params: { year, month, day, title: postSlug(post) }, props: { post } }
  })
}

const { post } = Astro.props as { post: Post }
const d = post.data
const file = post.filePath
const t = (await getSite()).post
// The date is not labelled: it is part of the article's address (/2025/08/29/...), so
// changing it would move the page and break every link to it.
---
<Default
  path={postUrl(post)}
  title={d.title}
  description={d.description}
  body={post.body}
  date={d.date}
  author={d.author}
  file={file}
>
<section class="ip ip--post">
  <div class="ip__inner ip__inner--wide">
    <article class="post" itemscope itemtype="http://schema.org/BlogPosting">
      <header class="ip__head">
        <p class="ip__label" {...edit(SITE_FILE, '/post/label', { label: 'Article pages: small line above the title' })}>{t.label}</p>
        <h1 class="ip__title" itemprop="name headline" {...edit(file, '/title', { label: 'Article title' })}>{d.title}</h1>
        <div class="ip-post__title-rule" aria-hidden="true"></div>
      </header>

      <div class="ip-post">
        <aside class="ip-post__meta">
          <p class="ip__meta">
            <time datetime={xmlschema(d.date)} itemprop="datePublished">
              {longDate(d.date)}
            </time>{d.author && (<Fragment><span>&middot;</span>
            <span itemprop="author" itemscope itemtype="http://schema.org/Person">
              <span itemprop="name" {...edit(file, '/author', { label: 'Author' })}>{d.author}</span>
            </span></Fragment>)}</p>
        </aside>

        <div class="ip-post__main">
          <div class="ip__content" itemprop="articleBody" {...edit(file, 'body', { type: 'rich', label: 'Article text', headings: '2 3' })}>
            <Fragment set:html={renderBody(post)} />
          </div>

          <footer class="ip__foot">
            <a class="ip__back" href="/articles/" {...edit(SITE_FILE, '/post/back', { label: 'Article pages: link back to the list' })}>{t.back}</a>
          </footer>
        </div>
      </div>
    </article>
  </div>
</section>
</Default>
