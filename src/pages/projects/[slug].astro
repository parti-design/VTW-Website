---
// One page per file in _projects/, at /projects/<file name>/. Was _layouts/project.html.
//
// Under the cover: the project info box (type, year, location, role, scope) beside the
// description box (the Markdown body). Every row and the description render even when
// empty so they can be clicked in the editor; on the live site CSS hides an empty row, and
// without a description the info runs across the page instead (main.css, "Project info").
// The photos are not labelled yet (see docs/editor.md); their alt text is the project
// title. The frame's texts (row names, headings, Gallery, Back to projects) are in
// _data/site.yml.
import Img from '../../components/Img.astro'
import Default from '../../layouts/Default.astro'
import { galleryImages, getProjects, getSite, projectCover, projectLabels, projectUrl, SITE_FILE, type Project } from '../../lib/content'
import { buildTime } from '../../lib/dates'
import { edit } from '../../lib/edit'
import { LARGE } from '../../lib/images'
import { renderBody } from '../../lib/jekyll'

export async function getStaticPaths() {
  return (await getProjects()).map((project) => ({ params: { slug: project.id }, props: { project } }))
}

const { project } = Astro.props as { project: Project }
const d = project.data
const file = project.filePath
const cover = projectCover(project, true)
const gallery = galleryImages(project)
const body = renderBody(project)
const t = (await getSite()).project
// The info box's rows: the row name (a site-wide text) and this project's value.
const info = [
  { key: 'type', name: t.info_type, value: d.type || t.default_type },
  { key: 'year', name: t.info_year, value: d.year },
  { key: 'location', name: t.info_location, value: d.location },
  { key: 'role', name: t.info_role, value: d.role },
  { key: 'scope', name: t.info_scope, value: d.scope },
] as const

---
<Default
  path={projectUrl(project)}
  title={d.title}
  description={d.description}
  body={project.body}
  date={buildTime}
  file={file}
>
<section class="ip ip--project">
  <div class="ip__inner ip__inner--wide">
    <article class="project-page">
      <header class="ip__head">
        <p class="ip__label" {...edit(file, '/type', projectLabels.type)}>{d.type || t.default_type}</p>
        <h1 class="ip__title" {...edit(file, '/title', projectLabels.title)}>{d.title}</h1>
      </header>{cover && (
      <figure class="project-cover"><Img src={cover} alt={d.title} sizes="(max-width: 980px) calc(100vw - 2.8rem), 1160px" widths={LARGE} loading="eager" decoding="sync" fetchpriority="high" />
      </figure>)}
      <div class="project-info-layout">
        <aside class="project-info" aria-labelledby="project-info-title">
          <h2 class="project-info__title" id="project-info-title" {...edit(SITE_FILE, '/project/info', { label: 'Project pages: info box heading' })}>{t.info}</h2>
          <dl class="project-info__list">{info.map((row) => (
            <div class="project-info__row"><dt {...edit(SITE_FILE, `/project/info_${row.key}`, { label: `Project pages: name of the ${row.key} row` })}>{row.name}</dt><dd {...edit(file, `/${row.key}`, projectLabels[row.key])}>{row.value}</dd></div>
          ))}</dl>
        </aside>
        <section class="project-about" aria-labelledby="project-about-title">
          <h2 class="project-about__title" id="project-about-title" {...edit(SITE_FILE, '/project/about', { label: 'Project pages: description heading' })}>{t.about}</h2>
          <div class="project-page__body ip__content" {...edit(file, 'body', { type: 'rich', label: 'Project description', placeholder: 'Add a description: what was there, what you did, what makes it special' })} set:html={body} />
        </section>
      </div>{gallery.length > 0 && (
      <section class="project-gallery" aria-label="Project photo gallery" data-project-lightbox>
        <h2 class="project-gallery__title" {...edit(SITE_FILE, '/project/gallery', { label: 'Project pages: gallery heading' })}>{t.gallery}</h2>
        <div class="project-gallery__grid">{gallery.map((src, i) => (
          <button
            class="project-gallery__item"
            type="button"
            data-lightbox-index={i}
            data-lightbox-src={src}
            aria-label={`Open image ${i + 1}`}
          ><Img src={src} alt={d.title} sizes="(max-width: 600px) calc(100vw - 2.8rem), (max-width: 980px) calc((100vw - 2.8rem - 0.85rem) / 2), 377px" />
          </button>
        ))}</div>

        <dialog class="project-lightbox" data-lightbox>
          <button class="project-lightbox__close" type="button" data-lightbox-close aria-label="Close gallery">&times;</button>
          <button class="project-lightbox__nav project-lightbox__nav--prev" type="button" data-lightbox-prev aria-label="Previous image">&larr;</button>
          <figure class="project-lightbox__frame">
            <img alt="" data-lightbox-image />
          </figure>
          <button class="project-lightbox__nav project-lightbox__nav--next" type="button" data-lightbox-next aria-label="Next image">&rarr;</button>
        </dialog>
      </section>)}

      <footer class="ip__foot">
        <a class="ip__back" href="/projects/" {...edit(SITE_FILE, '/project/back', { label: 'Project pages: link back to the list' })}>{t.back}</a>
      </footer>
    </article>
  </div>
</section>

<script is:inline>
  document.querySelectorAll('[data-project-lightbox]').forEach((gallery) => {
    const thumbs = Array.from(gallery.querySelectorAll('[data-lightbox-src]'));
    const lightbox = gallery.querySelector('[data-lightbox]');
    const lightboxImage = gallery.querySelector('[data-lightbox-image]');
    const close = gallery.querySelector('[data-lightbox-close]');
    const prev = gallery.querySelector('[data-lightbox-prev]');
    const next = gallery.querySelector('[data-lightbox-next]');
    let index = 0;

    if (!lightbox || !lightboxImage || thumbs.length === 0) return;

    const show = (nextIndex) => {
      index = (nextIndex + thumbs.length) % thumbs.length;
      const thumb = thumbs[index];
      lightboxImage.src = thumb.dataset.lightboxSrc;
      lightboxImage.alt = thumb.querySelector('img')?.alt || '';
    };

    thumbs.forEach((thumb, thumbIndex) => {
      thumb.addEventListener('click', () => {
        show(thumbIndex);
        lightbox.showModal();
      });
    });

    prev?.addEventListener('click', () => show(index - 1));
    next?.addEventListener('click', () => show(index + 1));
    close?.addEventListener('click', () => lightbox.close());
    lightbox.addEventListener('click', (event) => {
      if (event.target === lightbox) lightbox.close();
    });
    lightbox.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowLeft') show(index - 1);
      if (event.key === 'ArrowRight') show(index + 1);
    });
  });
</script>
</Default>
